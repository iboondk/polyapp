{
    "name": "polyapp/webhook-adapter",
    "description": "Laravel adapter that verifies signed PolyApp webhooks and creates projects through the PolyApp API.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "iboondk"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PolyApp\\WebhookAdapter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PolyApp\\WebhookAdapter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PolyApp\\WebhookAdapter\\WebhookAdapterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
